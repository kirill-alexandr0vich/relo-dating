rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Fields owned by Cloud Functions only — never client-writable, on
    // create or update. verified/premium/.../autoHidden are Cloud
    // Function counters and flags (12); name/bio/avatarUrls are blocked
    // for a different reason — they must pass moderation before being
    // saved (7.2), which only submitProfileText/submitProfilePhoto do.
    function protectedUserFields() {
      return [
        'verified', 'premium', 'premiumExpiresAt',
        'swipesUsedToday', 'swipesResetAt',
        'callMinutesUsedToday', 'callMinutesResetAt',
        'mediaMessagesUsedToday', 'mediaMessagesResetAt',
        'autoHidden', 'autoHiddenAt',
        'name', 'bio', 'avatarUrls'
      ];
    }

    // 9 — self-declared age is otherwise a plain client-writable field,
    // but the minimum-age requirement still has to be enforced somewhere
    // the client can't bypass.
    function validAge() {
      return !('age' in request.resource.data) || request.resource.data.age >= 18;
    }

    match /users/{uid} {
      // Candidate discovery for the swipe feed needs to read other users'
      // profiles; there is no per-field read restriction in Firestore
      // rules, so this is a known simplification (see README).
      allow read: if isSignedIn();

      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(protectedUserFields())
        && validAge();

      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields())
        && validAge();

      allow delete: if false;
    }

    // Username uniqueness reservation (5.2/3.2) — doc id is the
    // lowercased username, `uid` is who holds it. No moderation needed
    // (out of scope per 7.2's field list), just format + ownership.
    match /usernames/{username} {
      allow read: if isSignedIn();

      allow create: if isOwner(request.resource.data.uid)
        && username == username.lower()
        && username.matches('^[a-z0-9_]{3,20}$');

      allow update: if false;
      allow delete: if isOwner(resource.data.uid);
    }

    // Only the recordSwipe Cloud Function may write here (it runs as
    // admin and bypasses these rules) — this is what makes the daily
    // swipe limit and match creation trustworthy; see functions/src/swipes.
    match /swipes/{swipeId} {
      allow read: if isSignedIn() && resource.data.swiperId == request.auth.uid;
      allow write: if false;
    }

    // Only the onSwipeCreated Cloud Function may write here.
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow write: if false;
    }

    // 5.1 — doc id is the deterministic sorted-uid pair id (same scheme
    // as /matches and /chats), so it doubles as an uniqueness constraint:
    // a pair can only ever have one friendship doc.
    match /friends/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;

      // A blocked-sender check is intentionally not enforced here (known
      // simplification, see README) — sendMessage still refuses to let a
      // blocked pair talk even if a request were somehow accepted.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds[0] < request.resource.data.userIds[1]
        && friendshipId == request.resource.data.userIds[0] + '_' + request.resource.data.userIds[1]
        && request.resource.data.requestedBy == request.auth.uid
        && (
          (request.resource.data.addedVia == 'match'
            && request.resource.data.status == 'accepted'
            && exists(/databases/$(database)/documents/matches/$(friendshipId)))
          ||
          ((request.resource.data.addedVia == 'qr' || request.resource.data.addedVia == 'username_search')
            && request.resource.data.status == 'pending')
        );

      // Only the receiving side (not whoever sent the request) can
      // accept/decline, and only while it's still pending — no re-opening
      // a declined request.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.userIds
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);

      // Either side can unfriend/cancel a request at any time.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.userIds;
    }

    // 6 — only the sendMessage/blockUser Cloud Functions may write here;
    // messages must pass moderation and a connection check (match, or
    // accepted friend with both sides allowing it) before being saved.
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow write: if false;
      }
    }

    // 7.3 — doc id is deterministic per (reporter, target, reason) so a
    // repeat report from the same person for the same reason updates
    // their existing doc instead of creating a duplicate. Only the
    // onReportWritten Cloud Function reads these back (for the
    // unique-reporter count) and the not-yet-built moderator admin panel
    // would — never the reporting or reported user themselves.
    match /reports/{reportId} {
      allow read: if false;

      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.reason in
          ['spam', 'harassment', 'fake_profile', 'inappropriate_content', 'underage', 'other']
        && request.resource.data.status == 'pending'
        && reportId == request.auth.uid + '_' + request.resource.data.targetId + '_' + request.resource.data.reason;

      // A repeat report only refreshes createdAt/comment/contentSnapshot.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.reporterId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt', 'comment', 'contentSnapshot']);

      allow delete: if false;
    }
  }
}
