rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Staging area for a photo awaiting moderation (7.2) — only its
    // owner can read/write it, and only the submitProfilePhoto Cloud
    // Function moves it out from here. `request.resource` is only
    // defined for writes, so the size check must live on `write` alone —
    // combining it into a single `read, write` condition would make
    // reads evaluate against an undefined field.
    match /users/{uid}/pending/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && request.resource.size < 10 * 1024 * 1024;
    }

    // Published, already-moderated profile photos (3.2) — public read so
    // the swipe feed and profile screens can load them by URL; writes
    // only ever come from the Cloud Functions above (admin SDK, bypasses
    // these rules), never directly from a client.
    match /users/{uid}/photos/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // 6.1/6.3 — staging area for a chat photo/voice message awaiting
    // sendChatMedia (moderation for photos, connection check for both).
    // 15MB covers a several-minute voice clip; photos are already
    // compressed client-side (12) well under this. Same read/write split
    // as users/{uid}/pending above, for the same reason.
    match /chats/{chatId}/pending/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && request.resource.size < 15 * 1024 * 1024;
    }

    // 6.1/6.3 — published chat media. Private, unlike profile photos:
    // only the two participants may read it. `chatId` IS the sorted
    // `uidA_uidB` pair id (functions/src/shared/pairId.ts), and every
    // callable that writes here re-derives it from the caller's own uid
    // (otherParticipantOrThrow), so splitting the id is enough to know
    // the participants — no Firestore lookup needed. Writes only ever
    // come from sendChatMedia (admin SDK, bypasses these rules).
    match /chats/{chatId}/media/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid in chatId.split('_');
      allow write: if false;
    }
  }
}
