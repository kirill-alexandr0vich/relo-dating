rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Staging area for a photo awaiting moderation (7.2) — only its
    // owner can read/write it, and only the submitProfilePhoto Cloud
    // Function moves it out from here.
    match /users/{uid}/pending/{fileName} {
      allow read, write: if isOwner(uid) && request.resource.size < 10 * 1024 * 1024;
    }

    // Published, already-moderated profile photos (3.2) — public read so
    // the swipe feed and profile screens can load them by URL; writes
    // only ever come from the Cloud Functions above (admin SDK, bypasses
    // these rules), never directly from a client.
    match /users/{uid}/photos/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // 6.1/6.3 — staging area for a chat photo/voice message awaiting
    // sendChatMedia (moderation for photos, connection check for both).
    // 15MB covers a several-minute voice clip; photos are already
    // compressed client-side (12) well under this.
    match /chats/{chatId}/pending/{uid}/{fileName} {
      allow read, write: if isOwner(uid) && request.resource.size < 15 * 1024 * 1024;
    }

    // Published chat media — see sendChatMedia.ts's doc comment for why
    // this is public-by-unguessable-URL rather than participant-gated:
    // a stricter rule would need a cross-service Firestore lookup that
    // can't be verified without a live deploy in this environment.
    match /chats/{chatId}/media/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
