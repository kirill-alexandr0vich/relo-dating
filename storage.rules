rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Staging area for a photo awaiting moderation (7.2) — only its
    // owner can read/write it, and only the submitProfilePhoto Cloud
    // Function moves it out from here.
    match /users/{uid}/pending/{fileName} {
      allow read, write: if isOwner(uid) && request.resource.size < 10 * 1024 * 1024;
    }

    // Published, already-moderated profile photos (3.2) — public read so
    // the swipe feed and profile screens can load them by URL; writes
    // only ever come from the Cloud Functions above (admin SDK, bypasses
    // these rules), never directly from a client.
    match /users/{uid}/photos/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
