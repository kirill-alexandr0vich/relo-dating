# Copy to functions/.env (git-ignored) before deploying.

# 14.2 — App Check. Leave false until the app is registered in the
# Firebase console (Play Integrity for Android, DeviceCheck/App Attest for
# iOS) and a debug token is added for development builds: with it on,
# Cloud Functions reject every call that has no valid App Check token,
# including calls from the real app.
ENFORCE_APP_CHECK=false
